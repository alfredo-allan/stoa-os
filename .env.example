# Copie para .env.local (no seu computador) ou cadastre na Vercel em
# Settings → Environment Variables. Nunca comite valores reais.

# Senha do painel admin (obrigatória em produção)
ADMIN_PASSWORD=190216

# Opcional: chave para assinar o cookie de sessão. Se vazio, usa a própria senha.
ADMIN_SESSION_SECRET=

# Publicar alterações do admin como commit no GitHub
GITHUB_TOKEN=
GITHUB_REPO=alfredo-allan/stoa-os
GITHUB_BRANCH=main

# Criado automaticamente ao conectar um Vercel Blob ao projeto (Storage → Blob)
BLOB_READ_WRITE_TOKEN=
